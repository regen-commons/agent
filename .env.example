# --- Core ---

# Anthropic API key — console.anthropic.com
ANTHROPIC_API_KEY=

# Telegram bot token — from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# Random string you choose — Telegram echoes this back in webhook calls
# so you can verify the request is really from Telegram. Make it ~32 chars.
TELEGRAM_WEBHOOK_SECRET=

# Upstash Redis — auto-populated when you link an Upstash store from
# the Vercel marketplace (with the KV prefix).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Group / topic config ---

# Telegram group chat ID where the bot lives (negative number).
TELEGRAM_GROUP_CHAT_ID=

# "Agent" topic thread ID — the topic where the bot replies to mentions.
# Outside this topic and outside DMs, the bot stays silent.
TELEGRAM_AGENT_THREAD_ID=

# Notification topic thread ID — where /api/notify posts.
# Same value as TELEGRAM_AGENT_THREAD_ID if you're using one shared topic.
TELEGRAM_NOTIFICATION_THREAD_ID=

# --- Notify endpoint auth ---

# Random string the website's webhook must include as
# `Authorization: Bearer <this>`. ~32 chars.
NOTIFY_WEBHOOK_SECRET=
